+import Cocoa
+
+private enum DesktopMusicLibrary {
+  struct Track {
+    let url: URL
+    let title: String
+    let artist: String?
+
+    var searchText: String {
+      [title, artist ?? "", url.lastPathComponent].joined(separator: " ")
+    }
+  }
+
+  private static let extensions: Set<String> = [
+    "flac", "mp3", "m4a", "aac", "alac", "wav", "aiff", "aif", "ogg", "opus", "ape", "wma"
+  ]
+
+  static func files() throws -> [URL] {
+    let folder = FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent("Desktop/歌", isDirectory: true)
+    return try FileManager.default.contentsOfDirectory(
+      at: folder, includingPropertiesForKeys: [.isRegularFileKey], options: [.skipsHiddenFiles]
+    ).filter { url in
+      extensions.contains(url.pathExtension.lowercased()) &&
+        (try? url.resourceValues(forKeys: [.isRegularFileKey]).isRegularFile) == true
+    }.sorted {
+      $0.lastPathComponent.localizedStandardCompare($1.lastPathComponent) == .orderedAscending
+    }
+  }
+
+  static func track(_ url: URL) -> Track {
+    let tags = url.pathExtension.lowercased() == "flac" ? flacTags(url) : [:]
+    return Track(url: url, title: tags["title"] ?? url.deletingPathExtension().lastPathComponent,
+                 artist: tags["artist"] ?? tags["albumartist"])
+  }
+
+  private static func flacTags(_ url: URL) -> [String: String] {
+    // Read metadata only from local files so a search doesn't hydrate OneDrive placeholders.
+    let dataLessFlag: UInt32 = 0x40000000
+    var info = stat()
+    guard lstat(url.path, &info) == 0, info.st_flags & dataLessFlag == 0,
+          let file = try? FileHandle(forReadingFrom: url) else { return [:] }
+    defer { try? file.close() }
+    do {
+      guard try file.read(upToCount: 4) == Data("fLaC".utf8) else { return [:] }
+      while let data = try file.read(upToCount: 4), data.count == 4 {
+        let header = Array(data)
+        let length = Int(header[1]) << 16 | Int(header[2]) << 8 | Int(header[3])
+        if header[0] & 0x7f == 4 {
+          guard length <= 1_048_576, let block = try file.read(upToCount: length) else { return [:] }
+          return readComments(Array(block))
+        }
+        if header[0] & 0x80 != 0 { break }
+        try file.seek(toOffset: file.offset() + UInt64(length))
+      }
+    } catch {
+      return [:]
+    }
+    return [:]
+  }
+
+  private static func readComments(_ bytes: [UInt8]) -> [String: String] {
+    var position = 0
+    func readLength() -> Int? {
+      guard bytes.count - position >= 4 else { return nil }
+      let value = Int(bytes[position]) | Int(bytes[position + 1]) << 8 |
+        Int(bytes[position + 2]) << 16 | Int(bytes[position + 3]) << 24
+      position += 4
+      return value
+    }
+    guard let vendorLength = readLength(), vendorLength <= bytes.count - position else { return [:] }
+    position += vendorLength
+    guard let count = readLength() else { return [:] }
+    var tags: [String: String] = [:]
+    for _ in 0..<count {
+      guard let length = readLength(), length <= bytes.count - position else { break }
+      let field = String(decoding: bytes[position..<(position + length)], as: UTF8.self)
+      position += length
+      let parts = field.split(separator: "=", maxSplits: 1)
+      guard parts.count == 2 else { continue }
+      let key = parts[0].lowercased()
+      if ["title", "artist", "albumartist"].contains(key), tags[key] == nil {
+        tags[key] = String(parts[1])
+      }
+    }
+    return tags
+  }
+}
+
+private func musicLabel(_ zh: String, _ en: String) -> String {
+  Locale.preferredLanguages.first?.hasPrefix("zh") == true ? zh : en
+}
+
+final class DesktopMusicControls: NSStackView {
+  private let play: ([URL]) -> Void
+  private let playSearchResult: (URL, [URL]) -> Void
+  private let popover = NSPopover()
+
+  init(compact: Bool, play: @escaping ([URL]) -> Void, playSearchResult: @escaping (URL, [URL]) -> Void) {
+    self.play = play
+    self.playSearchResult = playSearchResult
+    super.init(frame: .zero)
+    orientation = .horizontal
+    alignment = .centerY
+    spacing = compact ? 6 : 8
+    translatesAutoresizingMaskIntoConstraints = false
+    let actions: [(String, Selector)] = [
+      (musicLabel("搜索歌曲", "Search Music"), #selector(search(_:))),
+      (musicLabel("顺序播放", "Play in Order"), #selector(playOrdered)),
+      (musicLabel("随机播放", "Shuffle"), #selector(playShuffled))
+    ]
+    for (label, action) in actions {
+      let button = NSButton(title: label, target: self, action: action)
+      button.bezelStyle = .rounded
+      button.controlSize = compact ? .small : .regular
+      addArrangedSubview(button)
+    }
+  }
+
+  required init?(coder: NSCoder) { nil }
+
+  @objc private func search(_ button: NSButton) {
+    if popover.isShown {
+      popover.close()
+      return
+    }
+    popover.behavior = .transient
+    let search = DesktopMusicSearch(play: { [weak self] url, library in
+      self?.popover.close()
+      self?.playSearchResult(url, library)
+    }, close: { [weak self] in
+      self?.popover.close()
+    })
+    popover.contentViewController = search
+    popover.contentSize = DesktopMusicSearch.contentSize
+    popover.show(relativeTo: button.bounds, of: button, preferredEdge: .maxY)
+  }
+
+  @objc private func playOrdered() { playLibrary(shuffled: false) }
+  @objc private func playShuffled() { playLibrary(shuffled: true) }
+
+  private func playLibrary(shuffled: Bool) {
+    do {
+      let files = try DesktopMusicLibrary.files()
+      guard !files.isEmpty else {
+        showLibraryMessage(musicLabel("桌面「歌」里没有可播放的音频。", "No playable files in Desktop/歌."))
+        return
+      }
+      popover.close()
+      play(shuffled ? files.shuffled() : files)
+    } catch {
+      showLibraryMessage(musicLabel("无法读取桌面「歌」。", "Could not read Desktop/歌."))
+    }
+  }
+
+  private func showLibraryMessage(_ text: String) {
+    guard let window else { return }
+    let alert = NSAlert()
+    alert.messageText = text
+    alert.beginSheetModal(for: window)
+  }
+}
+
+private final class DesktopMusicSearch: NSViewController, NSSearchFieldDelegate, NSTableViewDataSource, NSTableViewDelegate {
+  static let contentSize = NSSize(width: 360, height: 280)
+  private static let minimumResultsHeight: CGFloat = 180
+  private let play: (URL, [URL]) -> Void
+  private let close: () -> Void
+  private let query = NSSearchField()
+  private let table = NSTableView()
+  private let status = NSTextField(labelWithString: "")
+  private let playButton = NSButton()
+  private var tracks: [DesktopMusicLibrary.Track] = []
+  private var matches: [DesktopMusicLibrary.Track] = []
+  private var loading = true
+  private var unreadable = false
+
+  init(play: @escaping (URL, [URL]) -> Void, close: @escaping () -> Void) {
+    self.play = play
+    self.close = close
+    super.init(nibName: nil, bundle: nil)
+  }
+
+  required init?(coder: NSCoder) { nil }
+
+  override func loadView() {
+    view = NSView(frame: NSRect(origin: .zero, size: Self.contentSize))
+    preferredContentSize = Self.contentSize
+    query.placeholderString = musicLabel("歌名、歌手或文件名", "Song, artist, or filename")
+    query.delegate = self
+    let backButton = NSButton(title: musicLabel("返回", "Back"), target: self, action: #selector(closeSearch))
+    backButton.bezelStyle = .rounded
+    backButton.setContentHuggingPriority(.required, for: .horizontal)
+    let searchBar = NSStackView(views: [query, backButton])
+    searchBar.orientation = .horizontal
+    searchBar.spacing = 6
+
+    let trackColumn = NSTableColumn(identifier: NSUserInterfaceItemIdentifier("track"))
+    trackColumn.resizingMask = .autoresizingMask
+    table.addTableColumn(trackColumn)
+    table.columnAutoresizingStyle = .lastColumnOnlyAutoresizingStyle
+    table.headerView = nil
+    table.rowHeight = 26
+    table.delegate = self
+    table.dataSource = self
+    table.target = self
+    table.doubleAction = #selector(playClicked)
+
+    let scroll = NSScrollView()
+    scroll.hasVerticalScroller = true
+    scroll.autohidesScrollers = true
+    scroll.documentView = table
+
+    status.textColor = .secondaryLabelColor
+    status.font = .systemFont(ofSize: NSFont.smallSystemFontSize)
+    playButton.title = musicLabel("播放所选", "Play Selected")
+    playButton.bezelStyle = .rounded
+    playButton.target = self
+    playButton.action = #selector(playSelected)
+    playButton.setContentHuggingPriority(.required, for: .horizontal)
+    let resultBar = NSStackView(views: [status, playButton])
+    resultBar.orientation = .horizontal
+    resultBar.spacing = 6
+    for element in [searchBar, scroll, resultBar] {
+      element.translatesAutoresizingMaskIntoConstraints = false
+      view.addSubview(element)
+      element.leadingAnchor.constraint(equalTo: view.leadingAnchor, constant: 10).isActive = true
+      element.trailingAnchor.constraint(equalTo: view.trailingAnchor, constant: -10).isActive = true
+    }
+    NSLayoutConstraint.activate([
+      view.widthAnchor.constraint(greaterThanOrEqualToConstant: Self.contentSize.width),
+      searchBar.topAnchor.constraint(equalTo: view.topAnchor, constant: 10),
+      scroll.heightAnchor.constraint(greaterThanOrEqualToConstant: Self.minimumResultsHeight),
+      scroll.topAnchor.constraint(equalTo: searchBar.bottomAnchor, constant: 6),
+      resultBar.topAnchor.constraint(equalTo: scroll.bottomAnchor, constant: 6),
+      resultBar.bottomAnchor.constraint(equalTo: view.bottomAnchor, constant: -10)
+    ])
+    filter()
+    DispatchQueue.global(qos: .userInitiated).async { [weak self] in
+      do {
+        let files = try DesktopMusicLibrary.files()
+        let tracks = files.map(DesktopMusicLibrary.track)
+        DispatchQueue.main.async { self?.didLoad(tracks, unreadable: false) }
+      } catch {
+        DispatchQueue.main.async { self?.didLoad([], unreadable: true) }
+      }
+    }
+  }
+
+  override func viewDidAppear() {
+    super.viewDidAppear()
+    view.window?.makeFirstResponder(query)
+  }
+
+  private func didLoad(_ tracks: [DesktopMusicLibrary.Track], unreadable: Bool) {
+    self.tracks = tracks
+    self.unreadable = unreadable
+    loading = false
+    filter()
+  }
+
+  private func filter() {
+    let words = query.stringValue.split(whereSeparator: \.isWhitespace)
+    matches = tracks.filter { track in
+      words.allSatisfy { track.searchText.localizedStandardContains(String($0)) }
+    }
+    table.reloadData()
+    if !matches.isEmpty { select(0) }
+    playButton.isEnabled = matches.indices.contains(table.selectedRow)
+    if loading {
+      status.stringValue = musicLabel("正在读取歌曲…", "Loading songs…")
+    } else if unreadable {
+      status.stringValue = musicLabel("无法读取桌面「歌」。", "Could not read Desktop/歌.")
+    } else if matches.isEmpty {
+      status.stringValue = musicLabel("没有匹配的歌曲。", "No matching songs.")
+    } else {
+      status.stringValue = musicLabel("\(matches.count) 首", "\(matches.count) tracks")
+    }
+  }
+
+  private func select(_ row: Int) {
+    table.selectRowIndexes(IndexSet(integer: row), byExtendingSelection: false)
+    table.scrollRowToVisible(row)
+  }
+
+  func controlTextDidChange(_ notification: Notification) { filter() }
+
+  func control(_ control: NSControl, textView: NSTextView, doCommandBy command: Selector) -> Bool {
+    guard !textView.hasMarkedText() else { return false }
+    switch command {
+    case #selector(NSResponder.moveDown(_:)):
+      if !matches.isEmpty { select(min(table.selectedRow + 1, matches.count - 1)) }
+    case #selector(NSResponder.moveUp(_:)):
+      if !matches.isEmpty { select(max(table.selectedRow - 1, 0)) }
+    case #selector(NSResponder.insertNewline(_:)):
+      break
+    case #selector(NSResponder.cancelOperation(_:)):
+      close()
+    default:
+      return false
+    }
+    return true
+  }
+
+  @objc private func closeSearch() { close() }
+
+  override func cancelOperation(_ sender: Any?) { close() }
+
+  @objc private func playClicked() { playRow(table.clickedRow) }
+
+  @objc private func playSelected() { playRow(table.selectedRow) }
+
+  func tableViewSelectionDidChange(_ notification: Notification) {
+    playButton.isEnabled = matches.indices.contains(table.selectedRow)
+  }
+
+  private func playRow(_ row: Int) {
+    if matches.indices.contains(row) { play(matches[row].url, tracks.map(\.url)) }
+  }
+
+  func numberOfRows(in tableView: NSTableView) -> Int { matches.count }
+
+  func tableView(_ tableView: NSTableView, viewFor column: NSTableColumn?, row: Int) -> NSView? {
+    let track = matches[row]
+    let title = track.artist.map { "\(track.title) — \($0)" } ?? track.title
+    let label = NSTextField(labelWithString: title)
+    label.lineBreakMode = .byTruncatingTail
+    label.toolTip = track.url.lastPathComponent
+    return label
+  }
+}
